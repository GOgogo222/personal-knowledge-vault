# ========== Obsidian 系统文件 ==========
# 工作区状态文件：不同设备不同，不建议同步
.obsidian/workspace
.obsidian/workspace.json
.obsidian/workspaces.json

# 回收站：不需要同步
.obsidian/trash/
.obsidian/trash.json

# 核心插件迁移记录：临时文件
.obsidian/core-plugins-migration.json

# 设备特定配置：不同设备不同
.obsidian/desktop.json
.obsidian/mobile.json
.obsidian/app.json

# 插件备份目录：临时文件
.obsidian/plugins-backup/

# 同步冲突文件
.obsidian/sync-conflict/

# ========== 操作系统文件 ==========
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.directory
*~

# ========== 临时文件 ==========
*.tmp
*.temp
*.log
.cache/

# ========== 附件 ==========
# 大文件可按需取消注释，避免同步到 GitHub
